{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "marmot-lovers",
          "appId": "1:73613507053:android:f986d6452a4a4a4f6f4fe4",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "marmot-lovers",
          "configurations": {
            "android": "1:73613507053:android:f986d6452a4a4a4f6f4fe4",
            "ios": "1:73613507053:ios:92ef13fb6156e0e56f4fe4",
            "macos": "1:73613507053:ios:92ef13fb6156e0e56f4fe4",
            "web": "1:73613507053:web:7a5eb13bf03795316f4fe4",
            "windows": "1:73613507053:web:e70e0223ef0ba2cd6f4fe4"
          }
        }
      }
    }
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/flutter_service_worker.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/manifest.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
